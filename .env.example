# PostgreSQL connection string. Require TLS in production.
DATABASE_URL=postgresql://arena_user:change_me@localhost:5432/arena_forge
DATABASE_POOL_SIZE=10

# Comma-separated frontend origins allowed to call the API.
APP_ORIGIN=http://localhost:5173

# Frontend build-time API/Socket.IO URL.
VITE_API_URL=http://localhost:3001

PORT=3001
NODE_ENV=development
