# PostgreSQL connection string. Require TLS in production.
DATABASE_URL=postgresql://arena_user:change_me@localhost:5432/arena_forge
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call the API.
APP_ORIGIN=http://localhost:5173

# Frontend build-time API/Socket.IO URL.
VITE_API_URL=http://localhost:3001

PORT=3001
NODE_ENV=development

# Razorpay test/live API keys — get these from the Razorpay dashboard.
# NEVER commit real keys. RAZORPAY_KEY_SECRET must only ever be used server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo (transactional email) — used to send account email-verification links.
# Get BREVO_API_KEY from Brevo dashboard > SMTP & API > API Keys.
# BREVO_SENDER_EMAIL must be a sender you've verified in Brevo (Senders & IP > Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ring Tactics

# Single global launch flag. false/unset = Pre-Launch (Coming Soon + Pre-Register only).
# Set to true to make the full site/game publicly live.
LAUNCH_LIVE=false
