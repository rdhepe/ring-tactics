# PostgreSQL connection string. Require TLS in production.
DATABASE_URL=postgresql://arena_user:change_me@localhost:5432/arena_forge
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call the API.
APP_ORIGIN=http://localhost:5173

# Frontend build-time API/Socket.IO URL.
VITE_API_URL=http://localhost:3001

PORT=3001
NODE_ENV=development

# Razorpay test/live API keys — get these from the Razorpay dashboard.
# NEVER commit real keys. RAZORPAY_KEY_SECRET must only ever be used server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
